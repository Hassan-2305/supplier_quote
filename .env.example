# Copy to .env and adjust.
PORT=3000
ADMIN_PASSWORD=change-me-to-something-long
# Optional extra secret mixed into admin session signing
SESSION_SECRET=
# Public URL used in invite / edit links, e.g. https://suppliers.yourdomain.com
PUBLIC_URL=
# Set to false to accept submissions only through invitation links
ALLOW_OPEN_SUBMISSIONS=true
BRAND_NAME=Aekobaba
BRAND_CONTACT_EMAIL=
REF_PREFIX=SD
MAX_FILE_MB=25
# DATA_DIR=./data

# --- Production (Vercel) storage: Supabase -------------------------------
# Postgres connection string (Supabase > Connect > Transaction pooler, port 6543)
DATABASE_URL=
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploads (created automatically)
SUPABASE_BUCKET=supplier-files
